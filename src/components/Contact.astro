---
// Contact.astro — Contact form and information section
---

<section id="contacto" class="section contact-section">
  <div class="contact-glow glow-orb glow-orb-accent" aria-hidden="true"></div>

  <div class="container">
    <div class="section-header">
      <span class="section-label reveal">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
          ></path></svg
        >
        Contacto
      </span>
      <h2 class="reveal" data-delay="0.1">
        Empieza tu <span class="text-gradient">Proyecto</span> Hoy
      </h2>
      <p class="reveal" data-delay="0.2">
        Cuéntanos sobre tu negocio y te enviaremos una propuesta personalizada
        sin compromiso.
      </p>
    </div>

    <div class="contact-layout">
      <!-- Form -->
      <form
        class="contact-form glass-accent reveal"
        data-delay="0.2"
        id="contactForm"
      >
        <div class="form-row">
          <div class="form-group">
            <label for="contact-name">Nombre completo</label>
            <input
              type="text"
              id="contact-name"
              name="name"
              placeholder="Tu nombre"
              required
            />
          </div>
          <div class="form-group">
            <label for="contact-email">Email</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              placeholder="tu@email.com"
              required
            />
          </div>
        </div>

        <div class="form-group">
          <label for="contact-company">Empresa / Negocio</label>
          <input
            type="text"
            id="contact-company"
            name="company"
            placeholder="Nombre de tu empresa"
          />
        </div>

        <div class="form-group">
          <label for="contact-service">Servicio de interés</label>
          <select id="contact-service" name="service">
            <option value="">Selecciona un servicio</option>
            <option value="creacion-ecommerce">Creación de E-Commerce</option>
            <option value="gestion-ecommerce">Administración de E-Commerce</option>
            <option value="videos-marketing">Videos de Marketing</option>
            <option value="automatizacion">Sistemas de Automatización</option>
            <option value="redes-sociales">Gestión de Redes Sociales</option>
            <option value="google-meta-ads">Google y Meta Ads</option>
            <option value="estrategia-analitica">Estrategia y Analítica Digital</option>
            <option value="solucion-integral">Solución Integral</option>
          </select>
        </div>

        <div class="form-group">
          <label for="contact-message">Mensaje</label>
          <textarea
            id="contact-message"
            name="message"
            placeholder="Cuéntanos sobre tu proyecto..."
            rows="4"
            required></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-submit">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><line x1="22" y1="2" x2="11" y2="13"></line><polygon
              points="22 2 15 22 11 13 2 9 22 2"></polygon></svg
          >
          Solicitar Cotización
        </button>
      </form>

      <!-- Contact Info -->
      <div class="contact-info">
        <div class="info-card card reveal" data-delay="0.3">
          <div class="info-icon">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
              ></path></svg
            >
          </div>
          <div>
            <h4>WhatsApp</h4>
            <p>+57 315 764 4141</p>
          </div>
        </div>

        <div class="info-card card reveal" data-delay="0.4">
          <div class="info-icon">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><path
                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path><polyline points="22,6 12,13 2,6"></polyline></svg
            >
          </div>
          <div>
            <h4>Email</h4>
            <p>info@divisiondigital.co</p>
          </div>
        </div>

        <div class="info-card card reveal" data-delay="0.5">
          <div class="info-icon">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><circle cx="12" cy="12" r="10"></circle><line
                x1="2"
                y1="12"
                x2="22"
                y2="12"></line><path
                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
              ></path></svg
            >
          </div>
          <div>
            <h4>Redes Sociales</h4>
            <div class="social-links">
              <a
                href="https://www.instagram.com/division_digital_oficial"
                aria-label="Instagram"
                class="social-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><rect x="2" y="2" width="20" height="20" rx="5"></rect><path
                    d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                  ></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"
                  ></line></svg
                >
              </a>
              <a
                href="https://www.facebook.com/division.digital.oficial"
                aria-label="Facebook"
                class="social-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><path
                    d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                  ></path></svg
                >
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background: var(--bg-primary);
    position: relative;
    overflow: hidden;
  }

  .contact-glow {
    width: 500px;
    height: 500px;
    left: 50%;
    bottom: -200px;
    transform: translateX(-50%);
    opacity: 0.08;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  /* Form */
  .contact-form {
    padding: var(--space-2xl);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .form-group label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 12px 16px;
    background: var(--bg-tertiary);
    border: 1px solid var(--glass-border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.9375rem;
    transition: all var(--transition-fast);
    width: 100%;
  }

  .form-group select {
    appearance: none;
    cursor: pointer;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='%238a8aa3' stroke-width='2'%3E%3Cpolyline points='6 9 12 15 18 9'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 16px center;
    padding-right: 40px;
  }

  .form-group select option {
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--text-muted);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 100px;
  }

  .btn-submit {
    align-self: flex-start;
    margin-top: var(--space-sm);
  }

  /* Info */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .info-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-lg);
  }

  .info-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--accent-subtle);
    color: var(--accent);
    flex-shrink: 0;
  }

  .info-card h4 {
    color: var(--text-primary);
    margin-bottom: 4px;
    font-family: "Space Grotesk", sans-serif;
  }

  .info-card p {
    font-size: 0.9375rem;
  }

  .social-links {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--bg-tertiary);
    border: 1px solid var(--glass-border-subtle);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .social-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-subtle);
  }

  @media (max-width: 768px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initContactForm() {
    const contactWindow = window as Window & {
      __ddContactCleanup?: () => void;
    };
    contactWindow.__ddContactCleanup?.();

    const form = document.getElementById("contactForm") as HTMLFormElement;
    const controller = new AbortController();
    let resetTimer: number | undefined;

    form?.addEventListener(
      "submit",
      (e) => {
        e.preventDefault();
        const btn = form.querySelector(".btn-submit") as HTMLButtonElement;
        const originalText = btn.innerHTML;
        const formData = new FormData(form);
        const getFieldValue = (fieldName: string) =>
          String(formData.get(fieldName) ?? "").trim();

        const name = getFieldValue("name");
        const email = getFieldValue("email");
        const company = getFieldValue("company") || "No especificada";
        const message = getFieldValue("message");
        const serviceSelect = form.elements.namedItem(
          "service",
        ) as HTMLSelectElement | null;
        const service =
          getFieldValue("service") && serviceSelect?.selectedOptions[0]
            ? serviceSelect.selectedOptions[0].textContent?.trim()
            : "No especificado";
        const whatsappMessage = [
          `Hola, soy ${name}.`,
          "",
          `Email: ${email}`,
          `Empresa / Negocio: ${company}`,
          `Servicio de interés: ${service || "No especificado"}`,
          "",
          "Mensaje:",
          message,
        ].join("\n");
        const whatsappUrl = `https://wa.me/573157644141?text=${encodeURIComponent(
          whatsappMessage,
        )}`;

        btn.innerHTML = `
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        Abriendo WhatsApp...
      `;
        btn.style.pointerEvents = "none";

        const whatsappWindow = window.open(
          whatsappUrl,
          "_blank",
          "noopener,noreferrer",
        );

        if (!whatsappWindow) {
          window.location.href = whatsappUrl;
        }

        resetTimer = window.setTimeout(() => {
          btn.innerHTML = originalText;
          btn.style.pointerEvents = "";
          form.reset();
        }, 3000);
      },
      { signal: controller.signal },
    );

    contactWindow.__ddContactCleanup = () => {
      controller.abort();
      window.clearTimeout(resetTimer);
    };
  }

  document.addEventListener("DOMContentLoaded", initContactForm);
  document.addEventListener("astro:page-load", initContactForm);
  window.addEventListener("pagehide", () => {
    (
      window as Window & { __ddContactCleanup?: () => void }
    ).__ddContactCleanup?.();
  });
</script>
