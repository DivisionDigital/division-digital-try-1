---
// Services.astro — Interactive services carousel with direct quote actions
import { Image } from "astro:assets";
import analiticaVip from "../assets/Servicios/analitica-vip.png";
import cloudApi from "../assets/Servicios/cloud-api.png";
import disenoUxUi from "../assets/Servicios/diseno-ux-ui.png";
import inventarios from "../assets/Servicios/inventarios.png";
import megaEcommerce from "../assets/Servicios/mega-ecommerce.png";
import metricas from "../assets/Servicios/metricas.png";
import traficoB2b from "../assets/Servicios/trafico-b2b.png";

const services = [
  {
    title: "Creación de E-Commerce",
    category: "Venta digital",
    description: "Tiendas online que convierten visitas en ventas y crecen al ritmo de tu negocio.",
    highlights: ["Catálogo estratégico", "Pagos integrados", "Checkout ágil"],
    metric: "Tu tienda lista para vender",
    quoteValue: "creacion-ecommerce",
    image: megaEcommerce,
    accent: "247 8 92",
  },
  {
    title: "Administración de E-Commerce",
    category: "Operación comercial",
    description: "Mantenemos tu tienda activa, ordenada y enfocada en convertir cada oportunidad.",
    highlights: ["Inventario al día", "Campañas activas", "Conversión continua"],
    metric: "Operación que no se detiene",
    quoteValue: "gestion-ecommerce",
    image: inventarios,
    accent: "183 74 255",
  },
  {
    title: "Videos de Marketing",
    category: "Contenido que vende",
    description: "Piezas audiovisuales que capturan atención y hacen que tu producto se recuerde.",
    highlights: ["Reels que detienen", "Anuncios que venden", "Edición premium"],
    metric: "Contenido listo para destacar",
    quoteValue: "videos-marketing",
    image: disenoUxUi,
    accent: "255 126 54",
  },
  {
    title: "Sistemas de Automatización",
    category: "Procesos inteligentes",
    description: "Conectamos tareas, prospectos y datos para que tu equipo avance con menos fricción.",
    highlights: ["CRM conectado", "Flujos 24/7", "Menos tareas"],
    metric: "Menos tareas. Más tiempo.",
    quoteValue: "automatizacion",
    image: cloudApi,
    accent: "44 190 183",
  },
  {
    title: "Gestión de Redes Sociales",
    category: "Comunidad y marca",
    description: "Una presencia constante para que tu marca conecte, converse y se mantenga presente.",
    highlights: ["Calendario vivo", "Comunidad activa", "Marca consistente"],
    metric: "Tu marca en movimiento",
    quoteValue: "redes-sociales",
    image: traficoB2b,
    accent: "100 103 255",
  },
  {
    title: "Google y Meta Ads",
    category: "Adquisición de clientes",
    description: "Campañas de pauta enfocadas en llegar a personas con intención real de compra.",
    highlights: ["Audiencias listas", "Creativos que convierten", "ROAS medible"],
    metric: "Tráfico con intención",
    quoteValue: "google-meta-ads",
    image: metricas,
    accent: "247 8 92",
  },
  {
    title: "Estrategia y Analítica Digital",
    category: "Decisiones con datos",
    description: "Convertimos información de tu negocio en decisiones claras para crecer con dirección.",
    highlights: ["Métricas claras", "Decisiones rápidas", "Ruta de crecimiento"],
    metric: "Claridad para decidir",
    quoteValue: "estrategia-analitica",
    image: analiticaVip,
    accent: "183 74 255",
  },
];
---

<section id="servicios" class="section services-section">
  <div class="services-orb services-orb-left glow-orb glow-orb-accent" aria-hidden="true"></div>
  <div class="services-orb services-orb-right glow-orb" aria-hidden="true"></div>

  <div class="container">
    <div class="services-intro">
      <div class="services-intro-copy">
        <span class="section-label reveal">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z" />
          </svg>
          Servicios digitales
        </span>
        <h2 class="reveal" data-delay="0.1">
          Elige el próximo impulso de <span class="text-gradient">tu marca</span>
        </h2>
      </div>
      <p class="reveal" data-delay="0.2">
        Diseñamos el servicio exacto que tu negocio necesita hoy para vender, conectar y avanzar mañana.
      </p>
    </div>

    <div class="services-carousel reveal" data-delay="0.25" data-services-carousel>
      <div class="carousel-toolbar">
        <div class="carousel-toolbar-copy">
          <span class="carousel-kicker">Explora nuestra propuesta</span>
          <p>Desliza, descubre y encuentra la solución que hará que tu negocio se mueva.</p>
        </div>
        <div class="carousel-navigation">
          <span class="carousel-counter" data-carousel-counter aria-live="polite">01 / 07</span>
          <button class="carousel-control" type="button" data-carousel-prev aria-label="Ver servicios anteriores">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M19 12H5M11 18l-6-6 6-6" />
            </svg>
          </button>
          <button class="carousel-control carousel-control-next" type="button" data-carousel-next aria-label="Ver más servicios">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </button>
        </div>
      </div>

      <div class="carousel-viewport" data-carousel-viewport>
        <div class="carousel-track" data-carousel-track>
          {
            services.map((service, index) => (
              <article class="service-slide" style={`--service-rgb: ${service.accent}`} data-carousel-slide>
                <div class="service-slide-media">
                  <Image
                    src={service.image}
                    alt=""
                    width={760}
                    height={760}
                    loading={index > 2 ? "lazy" : "eager"}
                    class="service-slide-image"
                  />
                  <div class="service-slide-media-overlay"></div>
                  <span class="service-slide-number">{String(index + 1).padStart(2, "0")}</span>
                  <span class="service-slide-orbit" aria-hidden="true"></span>
                  <span class="service-slide-metric">{service.metric}</span>
                </div>

                <div class="service-slide-content">
                  <span class="service-slide-category">{service.category}</span>
                  <h3>{service.title}</h3>
                  <p>{service.description}</p>
                  <ul class="service-highlights" aria-label={`Incluye ${service.title}`}>
                    {service.highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                  <a href="#contacto" class="service-quote-button" data-quote-service={service.quoteValue}>
                    Quiero cotizar
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="carousel-footer">
        <div class="carousel-progress" aria-hidden="true">
          <span data-carousel-progress></span>
        </div>
        <p>Servicios diseñados para acompañarte desde la primera idea hasta la próxima venta.</p>
      </div>
    </div>

    <aside class="services-quote-panel reveal" data-delay="0.35">
      <div class="services-quote-spark" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1" />
        </svg>
      </div>
      <div>
        <span>Tu negocio merece una estrategia que se note</span>
        <h3>Hagamos que tu próxima acción digital tenga un impacto real.</h3>
      </div>
      <a href="#contacto" class="btn btn-primary services-quote-cta" data-quote-service="solucion-integral">
        Quiero mi cotización personalizada
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </aside>
  </div>
</section>

<script>
  import gsap from "gsap";

  function initServicesCarousel() {
    const servicesWindow = window as Window & {
      __ddServicesCarouselCleanup?: () => void;
    };
    servicesWindow.__ddServicesCarouselCleanup?.();

    const carousel = document.querySelector<HTMLElement>("[data-services-carousel]");
    const viewport = carousel?.querySelector<HTMLElement>("[data-carousel-viewport]");
    const track = carousel?.querySelector<HTMLElement>("[data-carousel-track]");
    const slides = Array.from(carousel?.querySelectorAll<HTMLElement>("[data-carousel-slide]") || []);
    const previousButton = carousel?.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const nextButton = carousel?.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const counter = carousel?.querySelector<HTMLElement>("[data-carousel-counter]");
    const progress = carousel?.querySelector<HTMLElement>("[data-carousel-progress]");
    const quoteLinks = document.querySelectorAll<HTMLAnchorElement>("[data-quote-service]");
    const serviceSelect = document.getElementById("contact-service") as HTMLSelectElement | null;
    const controller = new AbortController();

    if (!carousel || !viewport || !track || slides.length === 0) return;

    let activeIndex = 0;
    let autoPlayTimer: number | undefined;

    const cardsPerView = () => {
      if (window.innerWidth <= 640) return 1;
      if (window.innerWidth <= 980) return 2;
      return 3;
    };

    const maxIndex = () => Math.max(0, slides.length - cardsPerView());

    const updateCarousel = (animate = true) => {
      const cardWidth = slides[0]?.getBoundingClientRect().width || 0;
      const gap = Number.parseFloat(window.getComputedStyle(track).gap) || 0;
      activeIndex = Math.min(activeIndex, maxIndex());
      const offset = activeIndex * (cardWidth + gap);

      if (animate) {
        gsap.to(track, {
          x: -offset,
          duration: 0.72,
          ease: "power3.inOut",
          overwrite: "auto",
        });
      } else {
        gsap.set(track, { x: -offset });
      }

      slides.forEach((slide, index) => {
        const isVisible = index >= activeIndex && index < activeIndex + cardsPerView();
        slide.classList.toggle("is-carousel-visible", isVisible);
      });

      if (counter) {
        counter.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
      }

      if (progress) {
        progress.style.transform = `scaleX(${(activeIndex + 1) / (maxIndex() + 1)})`;
      }
    };

    const moveCarousel = (direction: 1 | -1) => {
      const lastIndex = maxIndex();
      activeIndex = direction === 1
        ? activeIndex >= lastIndex ? 0 : activeIndex + 1
        : activeIndex <= 0 ? lastIndex : activeIndex - 1;
      updateCarousel();
    };

    const stopAutoPlay = () => {
      window.clearInterval(autoPlayTimer);
      autoPlayTimer = undefined;
    };

    const startAutoPlay = () => {
      stopAutoPlay();
      autoPlayTimer = window.setInterval(() => moveCarousel(1), 6500);
    };

    previousButton?.addEventListener("click", () => moveCarousel(-1), { signal: controller.signal });
    nextButton?.addEventListener("click", () => moveCarousel(1), { signal: controller.signal });
    carousel.addEventListener("pointerenter", stopAutoPlay, { signal: controller.signal });
    carousel.addEventListener("pointerleave", startAutoPlay, { signal: controller.signal });
    carousel.addEventListener("focusin", stopAutoPlay, { signal: controller.signal });
    carousel.addEventListener("focusout", () => {
      window.setTimeout(() => {
        if (!carousel.matches(":focus-within")) startAutoPlay();
      }, 0);
    }, { signal: controller.signal });

    quoteLinks.forEach((link) => {
      link.addEventListener("click", () => {
        const serviceValue = link.dataset.quoteService;
        if (serviceSelect && serviceValue) serviceSelect.value = serviceValue;
      }, { signal: controller.signal });
    });

    const resizeObserver = new ResizeObserver(() => updateCarousel(false));
    resizeObserver.observe(viewport);
    updateCarousel(false);
    startAutoPlay();

    servicesWindow.__ddServicesCarouselCleanup = () => {
      controller.abort();
      stopAutoPlay();
      resizeObserver.disconnect();
      gsap.killTweensOf(track);
      gsap.set(track, { clearProps: "transform" });
    };
  }

  document.addEventListener("DOMContentLoaded", initServicesCarousel);
  document.addEventListener("astro:page-load", initServicesCarousel);
  window.addEventListener("pagehide", () => {
    (window as Window & { __ddServicesCarouselCleanup?: () => void }).__ddServicesCarouselCleanup?.();
  });
</script>

<style>
  .services-section {
    position: relative;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .services-orb {
    width: 600px;
    height: 600px;
    opacity: 0.09;
    pointer-events: none;
  }

  .services-orb-left {
    top: 2%;
    left: -360px;
  }

  .services-orb-right {
    right: -340px;
    bottom: 2%;
    opacity: 0.06;
  }

  .services-intro {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr);
    align-items: end;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .services-intro h2 {
    max-width: 740px;
    margin-top: var(--space-md);
  }

  .services-intro > p {
    max-width: 440px;
    margin-bottom: 0.35rem;
    font-size: 1.02rem;
  }

  .services-carousel {
    position: relative;
    z-index: 1;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 30px;
    background:
      linear-gradient(140deg, rgba(247, 8, 92, 0.09), transparent 27%),
      linear-gradient(315deg, rgba(107, 15, 255, 0.09), transparent 35%),
      rgba(8, 8, 14, 0.66);
    box-shadow: var(--shadow-lg), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(18px);
  }

  .carousel-toolbar,
  .carousel-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .carousel-toolbar {
    margin-bottom: var(--space-lg);
    padding: 0.25rem 0.25rem 0;
  }

  .carousel-kicker,
  .service-slide-category,
  .services-quote-panel > div > span {
    color: var(--accent-light);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .carousel-toolbar-copy p {
    margin-top: 0.35rem;
    color: var(--text-secondary);
    font-size: 0.86rem;
  }

  .carousel-navigation {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .carousel-counter {
    min-width: 58px;
    margin-right: 0.35rem;
    color: var(--text-primary);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.74rem;
    font-weight: 700;
    text-align: right;
  }

  .carousel-control {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    transition: background var(--transition-base), border-color var(--transition-base), color var(--transition-base), transform var(--transition-base);
  }

  .carousel-control:hover {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: var(--shadow-accent);
    transform: translateY(-2px);
  }

  .carousel-viewport {
    overflow: hidden;
    padding-bottom: 12px;
  }

  .carousel-track {
    display: flex;
    gap: var(--space-lg);
    will-change: transform;
  }

  .service-slide {
    display: flex;
    flex: 0 0 calc((100% - (var(--space-lg) * 2)) / 3);
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 22px;
    background: rgba(18, 18, 26, 0.85);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    opacity: 0.7;
    transform: scale(0.975);
    transition: border-color var(--transition-base), box-shadow var(--transition-base), opacity var(--transition-base), transform var(--transition-base);
  }

  .service-slide.is-carousel-visible {
    opacity: 1;
    transform: scale(1);
  }

  .service-slide:hover {
    border-color: rgb(var(--service-rgb) / 0.62);
    box-shadow:
      inset 0 0 0 1px rgb(var(--service-rgb) / 0.16),
      inset 0 -64px 86px rgb(var(--service-rgb) / 0.06);
  }

  .service-slide-media {
    position: relative;
    isolation: isolate;
    min-height: 225px;
    overflow: hidden;
    background: rgb(var(--service-rgb) / 0.12);
  }

  .service-slide-image {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.82;
    transform: scale(1.03);
    transition: transform 0.8s cubic-bezier(0.2, 0.75, 0.2, 1), opacity var(--transition-slow);
  }

  .service-slide:hover .service-slide-image {
    opacity: 1;
    transform: scale(1.12);
  }

  .service-slide-media-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(180deg, rgb(8 8 14 / 0.02) 15%, rgb(8 8 14 / 0.75) 100%),
      linear-gradient(120deg, rgb(var(--service-rgb) / 0.42), transparent 60%);
  }

  .service-slide-number {
    position: absolute;
    z-index: 3;
    top: 1rem;
    left: 1rem;
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.24);
    border-radius: 50%;
    background: rgb(8 8 14 / 0.38);
    color: var(--text-primary);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
  }

  .service-slide-orbit {
    position: absolute;
    z-index: 0;
    top: 20%;
    right: -32px;
    width: 138px;
    height: 138px;
    border: 1px solid rgb(255 255 255 / 0.27);
    border-radius: 50%;
    box-shadow: 0 0 0 24px rgb(var(--service-rgb) / 0.14), 0 0 0 46px rgb(var(--service-rgb) / 0.07);
    transform: rotate(-18deg);
    transition: transform 0.9s ease;
  }

  .service-slide:hover .service-slide-orbit {
    transform: rotate(20deg) scale(1.09);
  }

  .service-slide-metric {
    position: absolute;
    z-index: 3;
    right: 1rem;
    bottom: 0.9rem;
    left: 1rem;
    color: var(--text-primary);
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .service-slide-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.4rem 1.35rem 1.35rem;
  }

  .service-slide-content h3 {
    min-height: 2.3em;
    margin: 0.5rem 0 0.6rem;
    color: var(--text-primary);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
  }

  .service-slide-content > p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.58;
  }

  .service-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1rem 0 1.15rem;
    padding: 0;
    list-style: none;
  }

  .service-highlights li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.38rem 0.55rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    color: rgb(250 250 252 / 0.96);
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.005em;
    transition: border-color var(--transition-base), background var(--transition-base), transform var(--transition-base);
  }

  .service-highlights li::before {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(var(--service-rgb) / 0.95);
    box-shadow: 0 0 8px rgb(var(--service-rgb) / 0.7);
    content: "";
  }

  .service-slide:hover .service-highlights li {
    border-color: rgb(var(--service-rgb) / 0.34);
    background: rgb(var(--service-rgb) / 0.09);
  }

  .service-slide:hover .service-highlights li:nth-child(2) {
    transform: translateY(-2px);
  }

  .service-quote-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    width: 100%;
    margin-top: auto;
    padding: 0.85rem 1rem;
    border: 1px solid rgb(var(--service-rgb) / 0.62);
    border-radius: 12px;
    background: linear-gradient(135deg, rgb(var(--service-rgb) / 0.95), rgb(var(--service-rgb) / 0.65));
    box-shadow: 0 8px 24px rgb(var(--service-rgb) / 0.21);
    color: white;
    font-size: 0.86rem;
    font-weight: 700;
    transition: filter var(--transition-base), gap var(--transition-base), transform var(--transition-base);
  }

  .service-quote-button:hover {
    gap: 0.8rem;
    filter: brightness(1.16);
    transform: translateY(-2px);
  }

  .carousel-footer {
    margin-top: var(--space-lg);
    padding: 0 0.25rem 0.2rem;
  }

  .carousel-footer p {
    max-width: 470px;
    color: var(--text-muted);
    font-size: 0.75rem;
    text-align: right;
  }

  .carousel-progress {
    width: min(240px, 34%);
    height: 3px;
    overflow: hidden;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.11);
  }

  .carousel-progress span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: var(--gradient-accent);
    transform: scaleX(0.2);
    transform-origin: left;
    transition: transform 0.35s ease;
  }

  .services-quote-panel {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    padding: clamp(1.25rem, 3vw, 1.9rem);
    overflow: hidden;
    border: 1px solid rgba(247, 8, 92, 0.35);
    border-radius: var(--radius-xl);
    background: linear-gradient(105deg, rgba(247, 8, 92, 0.17), rgba(107, 15, 255, 0.15), rgba(18, 18, 26, 0.78));
    box-shadow: var(--shadow-accent);
  }

  .services-quote-panel::before {
    position: absolute;
    top: -120%;
    right: 8%;
    width: 360px;
